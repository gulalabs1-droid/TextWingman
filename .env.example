# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
TEXT_WINGMAN_AGENT_ID=your_agent_id_here
# Optional model overrides (defaults in lib/models.ts). Tasks: REPLY, VISION, DEEP, FAST.
# OPENAI_MODEL_REPLY=gpt-6.1-terra
# OPENAI_REASONING_REPLY=low

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRICE_ID_WEEKLY=price_weekly_id
STRIPE_PRICE_ID_MONTHLY=price_monthly_id
STRIPE_PRICE_ID_ANNUAL=price_annual_id

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to true only after Supabase email templates include {{ .Token }} (scripts/apply-auth-email-templates.mjs)
NEXT_PUBLIC_AUTH_EMAIL_CODE=false
# Free allowance is fixed in lib/usage-limits.ts (not configurable by env).

# Admin access (comma-separated emails) and the secret for /api/admin/grant-entitlement
ADMIN_EMAILS=you@example.com
ADMIN_SECRET=generate_a_long_random_string
# Optional: show demo data in admin dashboards (never enable in production)
# NEXT_PUBLIC_ADMIN_DEMO_MODE=false

# Vercel Cron: Vercel sends this as a Bearer token to /api/cron/keepalive
CRON_SECRET=generate_a_long_random_string

# Sentry error reporting (optional; reporting is off when unset)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
